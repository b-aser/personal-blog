DATABASE_URL=YourDatabaseUrlHere
PAYLOAD_SECRET=YourPayloadSecretHere

S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=eu-north-1
# Optional: custom S3-compatible endpoint (R2, MinIO). Leave unset for AWS S3.
# S3_ENDPOINT=
# Optional: CloudFront or custom CDN base URL. Defaults to https://{bucket}.s3.{region}.amazonaws.com
# S3_PUBLIC_URL=